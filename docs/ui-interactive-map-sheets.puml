@startuml ICCery-UI-sheets
title Sheets, dialogs, Spot Read, Gamut, Settings
skinparam classAttributeIconSize 0
hide circle
hide empty methods

package "SettingsView.swift  sheet from openSettingsBtn" {
  class "Argyll dir" as ad <<TextField+Browse>> {
    empty => bundled sidecars
  }
  class "Default instrument" as di <<Picker>> {
    None + i1/p3/CM/SS/20/22/41/51
    seeds Stage 3 + Spot Read
    does NOT change instrumentSelect
  }
  class "Enable i1Pro 2 LEDs" as led <<Toggle>>
  class "settingsDeltaEGood" as dg <<TextField.number>>
  class "settingsDeltaEWarning" as dw <<TextField.number>> {
    Save refuses unless Warning > Good
  }
  class "settingsCalStaleDays" as sd <<TextField.number>>
  class "Install location" as il <<Picker>> {
    User | System library
  }
  class "Ask before overwriting" as ao <<Toggle>>
  class "Open ColorSync after install" as oc <<Toggle>>
  class "Log level" as ll <<Picker>>
  class "Open log folder / Copy path / Copy excerpt" as lg <<Button x3>>
  class "Cancel / Save" as ss <<Button>> {
    Save stays on sheet if validation fails
    frame 560x620
  }
}

package "AboutView.swift" {
  class "aboutDialog" as ab <<Sheet>> {
    aboutVersion, aboutBuildDate
    closeAboutBtn  Esc
  }
}

package "savePresetDialog  PresetDialogs.swift" {
  class "savePresetName" as spn <<TextField>>
  class "savePresetDesc" as spd <<TextField>>
  class "btnCloseSavePresetDialog" as spc <<Button>>
  class "btnConfirmSavePreset" as sps <<Button>> {
    disabled: name trimmed empty
  }
}

package "managePresetsDialog" {
  class "presetRow-{id}" as prw <<Row>> {
    Built-in: no delete
    else btnExportPreset-{id} btnDeletePreset-{id}
  }
  class "btnImportPreset" as pim <<Button>>
  class "btnExportActivePreset" as pea <<Button>> {
    shown: selected custom preset
  }
  class "btnCloseManagePresetsDialog" as pcl <<Button>>
}

package "saveMediaRecipeDialog  MediaLibraryDialogs.swift" {
  class "saveMediaName/Notes/Paper/Ink" as smf <<TextField x4>>
  class "saveMediaPrinter/Preset/ColourSpace/Cal" as smr <<read-only>>
  class "saveMediaApplyCal" as smc <<Toggle>> {
    disabled: !calApplyable
    calApplyable: path exists, not CAL_ stem
  }
  class "btnCloseSaveMediaDialog" as smx <<Button>>
  class "btnConfirmSaveMedia" as sms <<Button>> {
    disabled: name|paper|ink empty
             OR captureColourSpaceMismatch
  }
}

package "manageMediaDialog" {
  class "mediaLibraryList" as mll <<List>> {
    mediaRow-{id}
    btnMediaLibraryApply-{id}
    btnMediaLibraryDelete-{id}
    double-click row = Apply
  }
  class "manageMediaNotice" as mmn <<Caption>> {
    shown: manageApplyNotice != nil
    in-sheet copy of failed Apply (#170)
  }
  class "btnMediaLibraryApply" as mla <<Button>> {
    Apply selected
    disabled: selection == nil
  }
  class "btnMediaLibraryCaptureFromManage" as mlc <<Button>> {
    dismiss then open capture
  }
  class "btnCloseManageMediaDialog" as mlx <<Button>>
  class "Delete alert" as mld <<alert>> {
    Cancel / Delete
  }
}

package "spotReadView  SpotReadView.swift  (#148)" {
  class "spotSidecarMissing" as ssm <<Text>> {
    shown: !sidecarAvailable
    hides instrument/transport
  }
  class "btnSpotDetectInstruments" as sdet <<Button>> {
    disabled: !canDetect  (detecting or running)
  }
  class "spotInstrumentSelect" as sis <<Picker>> {
    disabled: isRunning
  }
  class "spotDefaultMissing" as sdm <<Caption>> {
    shown: defaultMissing
  }
  class "spotSetDefault" as ssd <<Toggle>>
  class "spotXYHint" as sxy <<Caption>> {
    shown: selected is XY table
  }
  class "btnSpotStart" as sst <<Button>> {
    shown: !isRunning
    disabled: !canStart
    canStart: sidecar && !detecting && !running
              && !chartreadRunning && cwd
  }
  class "btnSpotCalibrate" as sca <<Button>> {
    shown: running && calibrating
  }
  class "btnSpotTrigger" as str <<Button>> {
    shown: running && awaitingStrip  (Read)
  }
  class "btnSpotStop" as ssp <<Button>> {
    shown: isRunning
  }
  class "spotLastSample / Lab / XYZ / DeltaE" as sls <<Display>> {
    spotLabImplausible if L not in 0...100
    spotDeltaE hidden on first sample
  }
  class "spotHistoryTable" as sht <<List>> {
    rows are buttons spotHistoryRow-{uuid}
    click restores last sample, no trigger
  }
  class "btnSpotCopyLab" as scp <<Button>> {
    disabled: displayedSample == nil
  }
  class "btnSpotExportCsv" as sex <<Button>> {
    disabled: samples.isEmpty
  }
  class "btnCloseSpotRead" as scl <<Button>> {
    Esc; onDismiss = Stop
  }
}

package "gamutView  GamutView.swift  (#147)" {
  class "gamutLayer-srgb" as gls <<Toggle.checkbox>> {
    sRGB always loaded; can hide; cannot remove
  }
  class "gamutLayer-profile" as glp <<Toggle>> {
    disabled: no session .gam
  }
  class "gamutLayer-compare" as glc <<Toggle>> {
    disabled: no compare layer
  }
  class "btnGamutAddCompare" as gac <<Menu>> {
    btnGamutOpenGam / btnGamutOpenProfile
  }
  class "btnGamutRemoveCompare" as grc <<Button>> {
    disabled: compare layer nil
  }
  class "btnGamutSampleTiff" as gst <<Button>>
  class "gamutViewerUnavailable" as gun <<Caption>> {
    shown: no Metal / SCNView failed
    toggles + inspect still enabled
  }
  class "btnResetGamutCamera" as grs <<Button>> {
    R when focused
  }
  class "gamutLabEntryL/A/B" as gle <<TextField x3>>
  class "btnGamutInspectLab" as gin <<Button>> {
    disabled: !canInspectLab
  }
  class "gamutInspectPanel" as gip <<Panel>>
  class "btnCloseGamut" as gcl <<Button>> {
    Esc
  }
  class "gamutTiffPreview sheet" as gtf <<Sheet>> {
    showingTiffPreview
    click pixel; btnCloseGamutTiffPreview
  }
}

package "Project alerts / relocate  RootView + ProjectUI" {
  class "projectNewAlert" as pna <<alert>> {
    btnProjectNewCancel / btnProjectNewConfirm
  }
  class "Dirty save alert" as pda <<alert>> {
    btnProjectDirtySave
    btnProjectDirtyDiscard
    btnProjectDirtyCancel
    shown when New/Open/Close and dirty
  }
  class "projectRelocateSheet" as prs <<Sheet>> {
    shown: cwd missing on Open
    btnProjectRelocateCancel
    btnProjectRelocate  Choose Folder…
  }
}

note as nMutex
  Mutex / exclusive
  Spot Read disabled while Stage 3 chartread runs
  Opening Spot Read never kills chartread_{basename}
  Calibrate uses temporary CAL_ basename; Save Project stays
  enabled so the refusal banner can fire; chip Save uses canSave
  Failed media Apply keeps manageMediaDialog open
  Window noticeText is occluded by that sheet — use manageMediaNotice
end note
@enduml
