@startuml ICCery-UI-shell
title ICCery v2 — interactive UI map (develop)\nobject names, files, enable / hide rules
caption Accessibility ids in quotes. Disk gating: WizardGating.swift. No App Sandbox.
skinparam classAttributeIconSize 0
skinparam wrapWidth 280
hide circle
hide empty methods

together {
  class "WindowGroup ICCery" as win <<ICCeryApp.swift>> {
    1280x800, min 1100x700
    File menu: ProjectCommands
  }
  class "RootView" as root <<RootView.swift>> {
    sidebar 270pt + stage column
    sheets / alerts hosted here
  }
}

win --> root

package "Persistent chrome" {
  class "SidebarView" as side <<SidebarView.swift>>
  class "NoticeBanner" as ban <<NoticeBanner.swift>> {
    id noticeText
    shown: wizard.notice != nil
    auto-hide 6s unless nil
    close: xmark (no a11y id)
  }
  class "WizardStageContent" as stage <<RootView.swift>> {
    switch wizard.stage
  }
}

root --> side
root --> ban
root --> stage

package "Sidebar header" {
  class "openSettingsBtn" as sSet <<Button>> {
    gearshape
    always enabled
    presents SettingsView sheet
  }
  class "openAboutBtn" as sAbt <<Button>> {
    info.circle
    always enabled
    presents AboutView
  }
  class "btnToggleAllHelp" as sHlp <<Button>> {
    questionmark.circle
    toggles showingAllHelp
    HelpOverlayView: yellow dots when on
  }
}
side --> sSet
side --> sAbt
side --> sHlp

package "Presets (#11)" {
  class "presetSelect" as pre <<Picker.menu>> {
    tags: none + ProfilingPreset.id
    set applies preset immediately
    "No preset" does not factory-reset
  }
  class "btnSavePresetModal" as preS <<Button>> {
    always enabled
    showingSavePreset = true
  }
  class "btnOpenPresetsDialog" as preM <<Button>> {
    always enabled
    showingManagePresets = true
  }
}
side --> pre
side --> preS
side --> preM

package "Media library (#146)" {
  class "mediaSelect" as med <<Picker.menu>> {
    tags: none + MediaRecipe.id
    never reuses presetSelect
    failed apply snaps back to none
  }
  class "mediaRecipeStale" as medSt <<Caption>> {
    shown: staleReasons[selected] nonempty
    "Printer not installed" or "Calibration stale"
  }
  class "btnMediaLibraryCapture" as medC <<Button>> {
    disabled: print.selectedPrinter.isEmpty
    needs Stage 2 queue
  }
  class "btnMediaLibraryManage" as medM <<Button>> {
    always enabled
  }
}
side --> med
side --> medSt
side --> medC
side --> medM

package "Studio (not stepper)" {
  class "btnCalibratePrinter" as calB <<Button>> {
    always enabled
    wizard.enterCalibration()
    Stage 0, not numbered
  }
  class "btnViewGamut" as gamB <<Button>> {
    Sidebar copy — same id as Stage 5
    always enabled
    no .gam => sRGB only
  }
  class "btnSpotRead" as spotB <<Button>> {
    disabled: workingDirectory==nil
             OR measurement.isChartreadRunning
  }
}
side --> calB
side --> gamB
side --> spotB

package "Stepper 1–5  (disk is truth)" {
  class "StepperRow stage N" as step <<Button.plain>> {
    WizardStage.stepperStages
    disabled / opacity 0.45 unless isUnlocked
    go(to:) allowed backward always
    calibrate is NOT a stepper row
  }
  note as nGate
    WizardGating.swift / WizardViewModel.isUnlocked
    1 generate: always
    2 layOutPrint: .ti1
    3 measure: .ti1 AND .ti2
    4 buildProfile: .ti3 (not .ti2 alone)
    5 verifyInstall: .ti3 AND .icc/.icm
    Re-probed on window key (#151)
  end note
}
side --> step
step .. nGate

package "Project chip (#149)  ProjectUI.swift" {
  class "projectChip" as chip <<Container>>
  class "projectChipName" as cn <<Text>> {
    bound name or "No project"
  }
  class "projectChipPath" as cp <<Text>> {
    shown if bound; last path component
  }
  class "projectChipStale" as cs <<Caption>> {
    shown: diskBehindNotes
  }
  class "btnProjectReveal" as cr <<Button>> {
    shown if bound
  }
  class "btnProjectSave" as csv <<Button>> {
    shown if bound
    disabled: !canSave
    canSave: isBound && basename && cwd
    CAL_ basename still enabled (refusal banner)
  }
  class "btnProjectOpen" as co <<Button>> {
    shown if NOT bound
  }
}
side --> chip
chip --> cn
chip --> cp
chip --> cs
chip --> cr
chip --> csv
chip --> co

package "File menu  ProjectCommands / ICCeryApp.swift" {
  class "menuProjectNew" as mN <<Button>> {
    ⌘N  requestNew()
  }
  class "menuProjectOpen" as mO <<Button>> {
    ⌘O
  }
  class "menuProjectRecents" as mR <<Menu>> {
    disabled: recents.isEmpty
    items: projectRecent-{bookmarkHash}
    menuProjectRecentsClear
  }
  class "menuProjectSave" as mS <<Button>> {
    ⌘S  disabled: !canSave
  }
  class "menuProjectSaveAs" as mSa <<Button>> {
    ⇧⌘S  disabled: !canSaveAs
    canSaveAs: basename && cwd (no bind required)
  }
  class "menuProjectReport" as mRp <<Button>> {
    disabled: !canReport
  }
  class "menuProjectClose" as mCl <<Button>> {
    disabled: !isBound
  }
}

stage --> "stage-1\nStage1View.swift" as st1
stage --> "stage-2\nStage2View.swift" as st2
stage --> "stage-3\nStage3View.swift" as st3
stage --> "stage-4\nStage4View.swift" as st4
stage --> "stage-5\nStage5View.swift" as st5
stage --> "stage-cal\nCalibrationView.swift" as st0
@enduml

