#!/bin/sh
# Mock applycal for Milestone 5 UI tests.
# Copies the input profile to the optional output path.
while [ "$#" -gt 0 ]; do
  case "$1" in
    -v|-a|-u) shift ;;
    *) break ;;
  esac
done
cal="$1"
input="$2"
output="$3"
if [ -n "$output" ]; then
  cp "$input" "$output"
else
  cp "$cal" "$input.cal.ctl"
fi
exit 0
